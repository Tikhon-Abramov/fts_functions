import type { ChangeEvent } from "react";

import {
    AttachFile,
    Close,
    InsertDriveFileOutlined,
    UploadFile,
} from "@mui/icons-material";
import {
    Box,
    Button,
    IconButton,
    Paper,
    Tooltip,
    Typography,
    useTheme,
} from "@mui/material";

export type FileAttachmentInputProps = {
    label: string;
    fileName?: string;
    selectedFile?: File | null;
    disabled?: boolean;
    required?: boolean;
    testId?: string;
    isDownloading?: boolean;
    onChangeFile: (file: File | null) => void;
    onDownloadFile?: () => void;
};

export function FileAttachmentInput({
                                        label,
                                        fileName,
                                        selectedFile,
                                        disabled = false,
                                        required = false,
                                        testId,
                                        isDownloading = false,
                                        onChangeFile,
                                        onDownloadFile,
                                    }: FileAttachmentInputProps) {
    const theme = useTheme();
    const c = theme.custom;

    const visibleFileName = selectedFile?.name || fileName || "";
    const hasFile = Boolean(visibleFileName);
    const canDownload = Boolean(fileName?.trim() && !selectedFile && onDownloadFile);

    const handleChange = (event: ChangeEvent<HTMLInputElement>) => {
        const file = event.target.files?.[0] ?? null;

        onChangeFile(file);
        event.target.value = "";
    };

    return (
        <Box data-testid={testId}>
            <Typography
                variant="caption"
                sx={{
                    display: "block",
                    color: c.textMuted,
                    fontSize: "0.66rem",
                    mb: 0.5,
                }}
            >
                {`${label}${required ? " *" : ""}`}
            </Typography>

            <Paper
                variant="outlined"
                sx={{
                    p: 1,
                    borderRadius: 1.5,
                    borderColor: canDownload ? theme.palette.primary.main : c.borderLight,
                    bgcolor: c.bgInput,
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between",
                    gap: 1,
                    minHeight: 44,
                }}
            >
                <Tooltip
                    title={
                        canDownload
                            ? isDownloading
                                ? "Файл скачивается..."
                                : "Скачать файл"
                            : hasFile
                                ? visibleFileName
                                : "Файл не прикреплён"
                    }
                >
                    <Box
                        component={canDownload ? "button" : "div"}
                        type={canDownload ? "button" : undefined}
                        onClick={canDownload ? onDownloadFile : undefined}
                        sx={{
                            minWidth: 0,
                            flex: 1,
                            display: "flex",
                            alignItems: "center",
                            gap: 0.75,
                            cursor: canDownload ? "pointer" : "default",
                            color: canDownload ? theme.palette.primary.main : undefined,
                            bgcolor: "transparent",
                            border: 0,
                            p: 0,
                            textAlign: "left",
                            font: "inherit",
                            "&:hover .file-name": canDownload
                                ? {
                                    textDecoration: "underline",
                                }
                                : undefined,
                        }}
                    >
                        {hasFile ? (
                            <InsertDriveFileOutlined
                                sx={{
                                    fontSize: 18,
                                    color: canDownload ? theme.palette.primary.main : c.textBody,
                                    flexShrink: 0,
                                }}
                            />
                        ) : (
                            <AttachFile
                                sx={{
                                    fontSize: 18,
                                    color: c.textMuted,
                                    flexShrink: 0,
                                }}
                            />
                        )}

                        <Typography
                            className="file-name"
                            sx={{
                                color: hasFile
                                    ? canDownload
                                        ? theme.palette.primary.main
                                        : c.textBody
                                    : c.textDim,
                                fontSize: "0.78rem",
                                overflow: "hidden",
                                whiteSpace: "nowrap",
                                textOverflow: "ellipsis",
                                fontWeight: canDownload ? 600 : 400,
                            }}
                            title={visibleFileName || "Файл не прикреплён"}
                        >
                            {isDownloading
                                ? "Скачивание..."
                                : visibleFileName || "Файл не прикреплён"}
                        </Typography>
                    </Box>
                </Tooltip>

                <Box sx={{ display: "flex", alignItems: "center", gap: 0.5 }}>
                    {selectedFile && !disabled && (
                        <Tooltip title="Убрать выбранный файл">
                            <IconButton
                                size="small"
                                onClick={() => onChangeFile(null)}
                                sx={{
                                    color: c.textMuted,
                                    "&:hover": {
                                        color: theme.palette.error.main,
                                        bgcolor: "transparent",
                                    },
                                }}
                            >
                                <Close sx={{ fontSize: 16 }} />
                            </IconButton>
                        </Tooltip>
                    )}

                    <Button
                        component="label"
                        size="small"
                        disabled={disabled}
                        startIcon={<UploadFile sx={{ fontSize: 16 }} />}
                        sx={{
                            textTransform: "none",
                            fontSize: "0.72rem",
                            color: c.accentBlue,
                            flexShrink: 0,
                        }}
                    >
                        {hasFile ? "Заменить" : "Прикрепить"}

                        <input hidden type="file" onChange={handleChange} />
                    </Button>
                </Box>
            </Paper>
        </Box>
    );
}

export default FileAttachmentInput;