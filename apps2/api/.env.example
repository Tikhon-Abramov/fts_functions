NODE_ENV=development

APP_NAME=Реестр функций ФНС

PINO_LOG_LEVEL=debug

NODE_HOST=127.0.0.1
NODE_HTTP_PORT=3000
NODE_HTTPS_PORT=3001

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

COOKIE_SECRET=secret_key

JWT_ACCESS_TOKEN_SECRET=secret_key
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

JWT_REFRESH_TOKEN_SECRET=secret_key
JWT_REFRESH_TOKEN_EXPIRATION_MS=1209600000

JWT_VERIFICATION_TOKEN_SECRET=secret_key
JWT_VERIFICATION_TOKEN_EXPIRATION_MS=43200000

JWT_PASSWORD_RESET_TOKEN_SECRET=secret_key
JWT_PASSWORD_RESET_TOKEN_EXPIRATION_MS=300000

DATABASE_USER=registry
DATABASE_PASSWORD=changeme
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=fts_functions
DATABASE_CONNECTION_LIMIT=100

DATABASE_URL=mysql://registry:changeme@127.0.0.1:3306/fts_functions?connection_limit=100

# ---------- Email (Resend) ----------
# Get a key at https://resend.com — leave empty to fall back to console-stub
# (the EmailService logs the message body instead of sending).
RESEND_API_KEY=
EMAIL_FROM=noreply@registry-functions.local
# Used to build verify-email and reset-password links sent by emails.
# Must point at the WEB origin (not the API), since these links target
# frontend routes like /verify-email and /reset-password.
PUBLIC_APP_URL=http://localhost:8787

# ---------- Object storage (MinIO / S3-compatible) ----------
# Endpoint accessible from the API process (e.g. http://127.0.0.1:9000).
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=registry-avatars
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
