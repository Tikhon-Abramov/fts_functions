/// Таблица обратной связи
model Feedback {
  /// Уникальный идентификатор обратной связи
  id Int @id @default(autoincrement())
  /// Уникальный идентификатор создавшего обратную связь
  creatorId                       Int?      @map("creator_id")
  /// Уникальный идентификатор отредактировавшего обратную связь
  updaterId                       Int?      @map("updater_id")
  /// Уникальный идентификатор акцептующего обратную связь
  acceptorId                      Int?      @map("acceptor_id")
  /// Уникальный идентификатор переставившего обратную связь
  reordererId                     Int?      @map("reorderer_id")
  /// Уникальный идентификатор удалившего обратную связь
  deleterId                       Int?      @map("deleter_id")
  /// Уникальный идентификатор строки детализации
  ftsFunctionDetailId             Int?      @map("fts_function_detail_id")
  /// Уникальный идентификатор строки действиия
  actionId                        Int?      @map("action_id")
  /// Уникальный идентификатор метрики обратной связи
  feedbackQualityMetricsId        Int?                      @map("feedback_quality_metrics_id")
  /// Методологическая позиция ЦА ФНС России из справочника
  ftsMethodologyStatusId          Int?                      @map("fts_methodology_status_id")
  /// Описание проблемы с указанием источника, метрики, способа решения
  problemDescription              String? @db.Text          @map("problem_description")
  /// Реквизиты автора инициативы
  initiatorRequisites             String? @db.Text          @map("initiator_requisites")
  /// Акцепт автора инициативы
  initiatorAcceptance             String? @db.Text          @map("initiator_acceptance")
  /// Срок реализации доработки
  deadline                        DateTime?                 @map("deadline")
  /// Уникальный идентификатор статуса согласования обратной связи
  acceptStatusId                  Int?                      @map("accept_status_id")
  /// Порядок расположения действий
  order                           Int?                      @map("order")
  /// Флаг мягкого удаления
  isDeleted                       Boolean @default(false)   @map("is_deleted")
  /// Дата создания
  createdAt                       DateTime  @default(now()) @map("created_at")
  /// Дата обновления
  updatedAt                       DateTime  @default(now()) @updatedAt @map("updated_at")
  /// Дата переупорядочивания
  reorderedAt                     DateTime?                 @map("reordered_at")
  /// Дата согласования
  acceptedAt                      DateTime?                 @map("accepted_at")
  /// Дата мягкого удаления (если удалена)
  deletedAt                       DateTime?                 @map("deleted_at")

  /// Связи с таблицей пользователей, исполнившие какое-либо действие
  creator   User? @relation("feedback_creator", fields: [creatorId], references: [id])
  updater   User? @relation("feedback_updater", fields: [updaterId], references: [id])
  acceptor  User? @relation("feedback_acceptor", fields: [acceptorId], references: [id])
  reorderer User? @relation("feedback_reorderer", fields: [reordererId], references: [id])
  deleter   User? @relation("feedback_deleter", fields: [deleterId], references: [id])

  /// Связь с таблицей детализаций функций ФНС
  ftsFunctionDetail FtsFunctionDetail? @relation(fields: [ftsFunctionDetailId], references: [id], onDelete: Cascade)

  /// Связь с таблицей действий
  action Action? @relation(fields: [actionId], references: [id], onDelete: Cascade)

  /// Связи с таблицей типов
  feedbackQualityMetrics Type? @relation("feedbacks__feedback_quality_metrics", fields: [feedbackQualityMetricsId], references: [id])
  ftsMethodologyStatus   Type? @relation("feedbacks__fts_methodology_status", fields: [ftsMethodologyStatusId], references: [id])
  acceptStatus           Type?  @relation("feedbacks__feedback_accept_status", fields: [acceptStatusId], references: [id])

  /// Связь с набором источников обратной связи
  feedbackSources EntityToType[]

  /// Связи с таблицей истории согласований
  agreementHistory FeedbackAgreementHistory[]

  @@map("feedback")
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

/// Действия для каждой детализации
model Action {
  /// Уникальный идентификатор действия
  id Int @id @default(autoincrement())
  /// Уникальный идентификатор создавшего детализацию функции
  creatorId                   Int?                    @map("creator_id")
  /// Уникальный идентификатор отредактировавшего детализацию функции
  updaterId                   Int?                    @map("updater_id")
  /// Уникальный идентификатор переставившего детализацию функции
  reordererId                 Int?                    @map("reorderer_id")
  /// Уникальный идентификатор удалившего детализацию функции
  deleterId                   Int?                    @map("deleter_id")
  /// Уникальный идентификатор строки детализации
  ftsFunctionDetailId         Int                     @map("fts_function_detail_id")
  /// Уникальный идентификатор статуса действия
  statusId                    Int                     @map("status_id")
  /// Описание действия
  description                 String @db.Text         @map("description")
  /// Приоритет выполнения действия
  priorityActionId            Int?                    @map("priority_action_id")
  /// Характер действия
  characterActionId           Int?                    @map("character_action_id")
  /// Уникальный идентификатор лица выполняющего действие над функции ФНС
  personPerformingActionId    Int?                    @map("person_performing_action_id")
  /// Иное лицо выполняющее действие над функции ФНС
  otherPersonPerformingAction String?                 @map("other_person_performing_action")
  /// Порядок расположения действий
  order                       Int?                    @map("order")
  /// Флаг мягкого удаления
  isDeleted                Boolean @default(false)    @map("is_deleted")
  /// Дата создания
  createdAt                DateTime @default(now())   @map("created_at")
  /// Дата обновления
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")
  /// Дата переупорядочивания
  reorderedAt              DateTime?                  @map("reordered_at")
  /// Дата мягкого удаления (если удалена)
  deletedAt                DateTime?                  @map("deleted_at")

  /// Связи с таблицей пользователей, исполнившие какое-либо действие
  creator   User? @relation("action_creator", fields: [creatorId], references: [id])
  updater   User? @relation("action_updater", fields: [updaterId], references: [id])
  reorderer User? @relation("action_reorderer", fields: [reordererId], references: [id])
  deleter   User? @relation("action_deleter", fields: [deleterId], references: [id])

  /// Связь с таблицей детализаций функций ФНС
  ftsFunctionDetail      FtsFunctionDetail @relation(fields: [ftsFunctionDetailId], references: [id], onDelete: Cascade)

  /// Связи с таблицей типов
  status                 Type  @relation("actions__status", fields: [statusId], references: [id])
  priorityAction         Type? @relation("action__priority_action", fields: [priorityActionId], references: [id])
  characterAction        Type? @relation("action__character_action", fields: [characterActionId], references: [id])
  personPerformingAction Type? @relation("action__person_performing_action", fields: [personPerformingActionId], references: [id])
  
  /// Связь с таблицей обратных связей
  feedbacks Feedback[]

  @@map("actions")
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

/// История согласования обратной связи
model FeedbackAgreementHistory {
  /// Уникальный идентификатор записи истории
  id                  Int @id @default(autoincrement())
  /// Уникальный идентификатор акцептующего обратную связь
  acceptorId          Int?                     @map("acceptor_id")
  /// Уникальный идентификатор обратной связи
  feedbackId          Int                      @map("feedback_id")
  /// Уникальный идентификатор статуса согласования обратной связи
  acceptStatusId      Int                      @map("accept_status_id")
  /// Комментарий при отказе
  comment             String? @db.Text         @map("comment")
  /// Дата создания записи истории
  createdAt           DateTime @default(now()) @map("created_at")

  /// Связи с таблицей пользователей, исполнившие какое-либо действие
  acceptor   User? @relation(fields: [acceptorId], references: [id])

  /// Связь с таблицей обратной связи
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  /// Связи с таблицей типов
  acceptStatus Type  @relation(fields: [acceptStatusId], references: [id])

  @@index([feedbackId])
  @@index([acceptStatusId])
  @@index([feedbackId, acceptStatusId])
  @@map("feedback_agreement_history")
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

/// Дерево функций ФНС
model FtsFunctionTree {
  /// Уникальный идентификатор создавшего связь
  creatorId           Int?      @map("creator_id")
  /// Уникальный идентификатор родительской детализации функции ФНС
  parentFtsFunctionId Int      @map("parent_fts_function_id")
  /// Уникальный идентификатор дочерней детализации функции ФНС
  childFtsFunctionId  Int      @map("child_fts_function_id")
  /// Уникальный идентификатор типа связи
  relationTypeId      Int      @map("relation_type_id")
  /// Дата создания связи
  createdAt           DateTime @default(now()) @map("created_at")

  /// Связи с таблицей пользователей, исполнившие какое-либо действие
  creator   User? @relation(fields: [creatorId], references: [id])

  /// Связи с таблицей детализаций функций ФНС
  parentFtsFunction FtsFunctionDetail @relation("data_children", fields: [parentFtsFunctionId], references: [id], onDelete: Cascade)
  childFtsFunction  FtsFunctionDetail @relation("data_parents", fields: [childFtsFunctionId], references: [id], onDelete: Cascade)

  /// Связи с таблицей типов
  relationType Type @relation(fields: [relationTypeId], references: [id])

  @@id([parentFtsFunctionId, childFtsFunctionId])
  @@index([childFtsFunctionId])
  @@index([relationTypeId])
  @@map("fts_function_tree")
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

model File {
  /// Уникальный идентификатор файла
  id                  Int       @id @default(autoincrement())
  /// Уникальный идентификатор создавшего файл
  creatorId           Int?      @map("creator_id")
  /// Уникальный идентификатор отредактировавшего файл
  updaterId           Int?      @map("updater_id")
  /// Уникальный идентификатор удалившего файл
  deleterId           Int?      @map("deleter_id")
  /// Уникальный идентификатор строки детализации
  ftsFunctionDetailId Int?      @map("fts_function_detail_id")
  /// Ключ объекта в S3
  objectKey           String    @map("object_key") @db.VarChar(128)
  /// Оригинальное имя файла
  originalName        String?   @map("original_name") @db.VarChar(255)
  /// MIME-тип файла
  mimeType            String?   @map("mime_type") @db.VarChar(100)
  /// Размер файла в байтах
  size                Int?      @db.UnsignedInt
  /// Дата загрузки
  createdAt           DateTime  @default(now()) @map("created_at")
  /// Дата обновления
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  /// Дата удаления
  deletedAt           DateTime? @map("deleted_at")
  /// Флаг подтверждения загрузки
  isUploadConfirmed   Boolean   @default(false) @map("is_upload_confirmed")
  /// Флаг удаления
  isDeleted           Boolean   @default(false) @map("is_deleted")

  /// Связи с таблицей пользователей, исполнившие какое-либо действие
  creator   User? @relation("file_creator", fields: [creatorId], references: [id])
  updater   User? @relation("file_updater", fields: [updaterId], references: [id])
  deleter   User? @relation("file_deleter", fields: [deleterId], references: [id])

  /// Связь со строкой детализации
  ftsFunctionDetail FtsFunctionDetail? @relation(fields: [ftsFunctionDetailId], references: [id])

  @@index([isUploadConfirmed, isDeleted])
  @@index([createdAt])
  @@index([createdAt, isUploadConfirmed])
  @@index([objectKey])
  @@index([ftsFunctionDetailId, isDeleted, isUploadConfirmed])
  @@index([ftsFunctionDetailId, isDeleted])
  @@map("files")
}
