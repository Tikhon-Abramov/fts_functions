{
  "name": "@registry/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.mjs",
      "require": "./dist/errors/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.mjs",
      "require": "./dist/enums/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.mjs",
      "require": "./dist/validation/index.js"
    },
    "./colors": {
      "types": "./dist/colors/index.d.ts",
      "import": "./dist/colors/index.mjs",
      "require": "./dist/colors/index.js"
    }
  },
  "scripts": {
    "build": "tsup index.ts errors/index.ts enums/index.ts validation/index.ts colors/index.ts --format esm,cjs --dts --clean --out-dir dist",
    "postinstall": "tsup index.ts errors/index.ts enums/index.ts validation/index.ts colors/index.ts --format esm,cjs --dts --clean --out-dir dist || true"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
