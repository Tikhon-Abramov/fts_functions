{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "ignoreBinaries": ["eslint"],
  "ignoreDependencies": [
    "eslint",
    "eslint-config-prettier",
    "eslint-plugin-prettier",
    "eslint-plugin-simple-import-sort",
    "prisma-client-js"
  ],
  "workspaces": {
    ".": {
      "entry": ["eslint.config.shared.ts"],
      "project": ["*.{ts,js,mjs,cjs}"],
      "ignoreDependencies": [
        "jiti",
        "eslint-plugin-i18next",
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-unicorn"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.spec.ts",
        "test/**/*.e2e-spec.ts",
        "db/seeds/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "db/**/*.ts"],
      "ignore": [
        "src/generated/**",
        "src/zod/**",
        "zod/**",
        "dist/**",
        "prisma.config.ts",
        "src/common/logger/**",
        "src/common/schemas/**",
        "src/common/errors/**",
        "src/common/prisma/mappers/**",
        "src/common/config/**",
        "src/common/constants/**",
        "src/module/fts-function/internal/fts-function.selects.ts",
        "src/module/fts-function/fts-function.schema.ts",
        "src/module/constant/constant.schema.ts",
        "db/sql/**"
      ],
      "ignoreDependencies": [
        "@nestjs/cli",
        "@nestjs/schematics",
        "ts-loader",
        "source-map-support",
        "tsconfig-paths",
        "ts-node",
        "@types/passport-jwt",
        "@types/passport-local",
        "@types/qs",
        "qs",
        "@anatine/zod-openapi",
        "swagger-ui-express",
        "@fastify/static",
        "@fastify/csrf-protection",
        "@fastify/compress",
        "@nestjs/jwt",
        "@nestjs/passport",
        "@nestjs/serve-static",
        "bcryptjs",
        "class-transformer",
        "class-validator",
        "@eslint/eslintrc",
        "@prisma/client",
        "@types/supertest",
        "eslint-plugin-boundaries",
        "eslint-plugin-simple-import-sort",
        "supertest",
        "nestjs-pino",
        "pino"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/test-setup.ts",
        "src/**/*.{test,spec}.{ts,tsx}",
        "e2e/**/*.spec.ts",
        "src/components/ui/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignore": [
        "dist/**",
        "playwright-report/**",
        "test-results/**",
        "src/shared/api/ftsFunctionsApi.ts",
        "src/components/ui/**",
        "src/entities/fts-function/hooks/**",
        "src/shared/i18n/**",
        "src/shared/store/**",
        "src/shared/ui/**",
        "e2e/helpers/**"
      ],
      "ignoreDependencies": [
        "@types/node",
        "@types/qs",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react",
        "@tailwindcss/typography",
        "@tailwindcss/vite",
        "autoprefixer",
        "postcss",
        "tailwindcss",
        "tailwindcss-animate",
        "tw-animate-css",
        "esbuild",
        "bufferutil",
        "@replit/vite-plugin-cartographer",
        "@replit/vite-plugin-dev-banner",
        "@replit/vite-plugin-runtime-error-modal",
        "@jridgewell/trace-mapping",
        "@radix-ui/react-accordion",
        "@radix-ui/react-alert-dialog",
        "@radix-ui/react-aspect-ratio",
        "@radix-ui/react-avatar",
        "@radix-ui/react-checkbox",
        "@radix-ui/react-collapsible",
        "@radix-ui/react-context-menu",
        "@radix-ui/react-dialog",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-hover-card",
        "@radix-ui/react-label",
        "@radix-ui/react-menubar",
        "@radix-ui/react-navigation-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-progress",
        "@radix-ui/react-radio-group",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-select",
        "@radix-ui/react-separator",
        "@radix-ui/react-slider",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-tabs",
        "@radix-ui/react-toast",
        "@radix-ui/react-toggle",
        "@radix-ui/react-toggle-group",
        "@radix-ui/react-tooltip",
        "class-variance-authority",
        "clsx",
        "cmdk",
        "date-fns",
        "embla-carousel-react",
        "framer-motion",
        "input-otp",
        "lucide-react",
        "next-themes",
        "react-day-picker",
        "react-icons",
        "recharts",
        "tailwind-merge",
        "vaul",
        "zod-validation-error",
        "@testing-library/user-event",
        "eslint-config-prettier",
        "eslint-plugin-prettier",
        "eslint-plugin-simple-import-sort",
        "prettier"
      ]
    },
    "packages/shared": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"],
      "ignore": ["dist/**"]
    },
    "packages/eslint-plugin-registry-functions": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
